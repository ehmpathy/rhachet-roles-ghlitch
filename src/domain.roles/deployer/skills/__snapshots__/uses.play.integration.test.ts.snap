exports[`uses (deploy.uses + provision.uses prod gate) given: [case20] provision.database help documents --gate when: [t0] help is requested then: the help output matches snapshot 1`] = `
"🐈 heres the deal...

⛵ provision.database

usage:
  rhx provision.database --which livedb --env <env> --mode <mode>

options:
  --which  database target: livedb (required)
  --env    environment: prep or prod (required). narrower than the kin skills'
           test|prep|prod|camp on purpose — a live schema exists only in prep
           and prod, so the other envs name no database to reach
  --mode   operation: plan, apply, or sync (required)
  --slug   change slug (required for --mode sync; forbidden otherwise)
  --gate   whose gate clears a PROD write (default: for-ehmpath)
             for-ehmpath  the quota a human granted the agent (local meter)
             for-cicd     the github-environment approval (requires CI=true)

example:
  rhx provision.database --which livedb --env prep --mode plan
"
`;

